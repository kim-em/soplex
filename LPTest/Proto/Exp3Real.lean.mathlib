/-
Exp 3 — the generic IntModule machinery at `ℝ`, via Mathlib.

De-risks "Real for free": once Mathlib is imported, do the `Lean.Grind` classes
the generic `lp` machinery needs resolve at `ℝ`, and do the generic closer /
reflective normalizer / field-clearing lemmas instantiate at `ℝ`?

Names are fully qualified with `Lean.Grind.`/`Std.` because Mathlib re-uses many
of the same identifiers (`Field`, `Semiring`, `Preorder`, `le_trans`, …).

Compile from the mathlib4 project env:
  cd /Users/kim/projects/lean/mathlib4 && lake env lean /tmp/Exp3Real.lean
-/
import Mathlib.Data.Real.Basic
import Mathlib.Tactic.NormNum.Basic
import Init.Grind.Ordered.Linarith

open Lean.Grind.Linarith

/-! ## 1. The six grind classes resolve at `ℝ` (the core de-risk) -/

#synth Lean.Grind.IntModule ℝ
#synth Lean.Grind.OrderedAdd ℝ
#synth Std.IsLinearOrder ℝ
#synth Std.LawfulOrderLT ℝ
#synth Lean.Grind.OrderedRing ℝ
#synth Lean.Grind.Field ℝ

/-! ## 2. The generic scaled closer (Exp 0), restated and applied at `ℝ` -/

section Closer
variable {M : Type u}
  [Lean.Grind.IntModule M] [LE M] [LT M]
  [Std.IsLinearOrder M] [Std.LawfulOrderLT M] [Lean.Grind.OrderedAdd M]

theorem nonneg_of_zsmul_nonneg {L : Int} {z : M} (hL : 0 < L) (h : 0 ≤ L • z) :
    0 ≤ z := by
  apply Classical.byContradiction
  intro hz
  have hz' : z < 0 := Lean.Grind.LinearOrder.lt_of_not_le hz
  have hneg : L • z < 0 := (Lean.Grind.OrderedAdd.zsmul_neg_iff L hz').mpr hL
  exact Lean.Grind.Preorder.lt_irrefl 0 (Lean.Grind.Preorder.lt_of_le_of_lt h hneg)

theorem scaled_le_close {L : Int} {lhs rhs s C : M}
    (hL : 0 < L) (hSum : s ≤ 0) (hC : 0 ≤ C)
    (hIdent : L • (rhs - lhs) + s = C) : lhs ≤ rhs := by
  apply Lean.Grind.OrderedAdd.sub_nonneg_iff.mp
  apply nonneg_of_zsmul_nonneg hL
  have hstep : L • (rhs - lhs) = C - s := by
    rw [← hIdent, Lean.Grind.AddCommGroup.add_sub_cancel]
  rw [hstep]
  exact Lean.Grind.OrderedAdd.sub_nonneg_iff.mpr (Std.IsPreorder.le_trans s 0 C hSum hC)

end Closer

-- Applied at `ℝ` against abstract hypotheses (instance resolution is the point).
example (x y : ℝ) {L : Int} {s C : ℝ}
    (hL : 0 < L) (hSum : s ≤ 0) (hC : 0 ≤ C)
    (hId : L • (y - x) + s = C) : x ≤ y :=
  scaled_le_close hL hSum hC hId

/-! ## 3. Reflective `Poly` normalizer (Exp 2) at `ℝ` -/

theorem of_norm_eq {α} [Lean.Grind.IntModule α] (ctx : Context α) (e₁ e₂ : Expr)
    (h : e₁.norm = e₂.norm) : e₁.denote ctx = e₂.denote ctx := by
  rw [← Expr.denote_norm ctx e₁, ← Expr.denote_norm ctx e₂, h]

private def cancelE : Expr :=
  .add (.add (.intMul 3 (.var 0)) (.intMul 2 (.var 1)))
       (.add (.intMul (-3) (.var 0)) (.intMul (-2) (.var 1)))

example (x y : ℝ) :
    cancelE.denote (.branch 1 (.leaf x) (.leaf y)) = (0 : ℝ) := by
  have h := of_norm_eq (.branch 1 (.leaf x) (.leaf y)) cancelE .zero (by rfl)
  simpa [Expr.denote] using h

/-! ## 4. Field-clearing of a rational coefficient (Exp 1) at `ℝ` -/

section Clear
variable {K : Type u}
  [Lean.Grind.Field K] [LE K] [LT K]
  [Std.IsLinearOrder K] [Std.LawfulOrderLT K] [Lean.Grind.OrderedRing K]

theorem clear_field_row {d c x b : K} (hd : 0 < d) (hdc : d * c = 1)
    (h : c * x ≤ b) : x ≤ d * b := by
  have hstep := Lean.Grind.OrderedRing.mul_le_mul_of_nonneg_left h
    (Lean.Grind.Preorder.le_of_lt hd)
  rwa [← Lean.Grind.Semiring.mul_assoc, hdc, Lean.Grind.Semiring.one_mul] at hstep

end Clear

-- At `ℝ`: `(1/2)·x ≤ 3` clears to `x ≤ 2·3`; `norm_num` discharges the field facts.
example (x : ℝ) (h : (1 / 2 : ℝ) * x ≤ 3) : x ≤ 2 * 3 :=
  clear_field_row (by norm_num) (by norm_num) h
